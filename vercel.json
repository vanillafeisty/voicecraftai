{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/tts/generate",
      "destination": "/api/tts/generate"
    },
    {
      "source": "/api/tts/download-text",
      "destination": "/api/tts/download-text"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
